# ── LLM ────────────────────────────────────────────────────────────────────
# Retained Gemini configuration is not selected by the active model factories.
# The documented baseline requires Groq; a Gemini key alone does not enable it.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_TRIAGE_MODEL=gemini-2.5-flash
GEMINI_SYNTHESIS_MODEL=gemini-2.5-flash

GROQ_API_KEY=your_groq_api_key
GROQ_TRIAGE_MODEL=openai/gpt-oss-20b
GROQ_SYNTHESIS_MODEL=openai/gpt-oss-120b

# ── Cloudflare Workers AI (embeddings + small model fallback) ───────────────
CF_ACCOUNT_ID=your_cf_account_id
CF_WORKERS_AI_TOKEN=your_cf_workers_ai_token

# ── Qdrant Cloud ────────────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_KB_COLLECTION=kb_chunks
QDRANT_HEALTH_BENEFITS_COLLECTION=health_benefit_chunks
RETRIEVAL_MIN_SCORE=0.60
RETRIEVAL_CANDIDATE_MULTIPLIER=4

# ── Appwrite ────────────────────────────────────────────────────────────────
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id
# Account deletion additionally requires rows.read/write, files.read/write,
# and users.write scopes on this server key.
APPWRITE_API_KEY=your_appwrite_server_api_key
APPWRITE_DATABASE_ID=your_appwrite_database_id

# Existing collections (read-only from chatbot)
APPWRITE_USERS_COLLECTION_ID=your_users_collection_id
APPWRITE_DIARY_COLLECTION_ID=your_diary_collection_id
APPWRITE_ACHIEVEMENTS_COLLECTION_ID=your_achievements_collection_id
APPWRITE_MILESTONES_COLLECTION_ID=your_milestones_collection_id
APPWRITE_HEALTH_BENEFITS_COLLECTION_ID=your_health_benefits_collection_id
APPWRITE_FORUM_COLLECTION_ID=your_forum_collection_id
APPWRITE_CHALLENGES_COLLECTION_ID=your_challenges_collection_id
APPWRITE_CHALLENGE_ENTRIES_COLLECTION_ID=your_challenge_entries_collection_id
APPWRITE_MOTIVATIONS_COLLECTION_ID=your_motivations_collection_id
APPWRITE_FRIENDSHIPS_COLLECTION_ID=your_friendships_collection_id
APPWRITE_FRIEND_REQUESTS_COLLECTION_ID=your_friend_requests_collection_id
APPWRITE_DIRECT_MESSAGES_COLLECTION_ID=your_direct_messages_collection_id
APPWRITE_MESSAGES_MISC_COLLECTION_ID=your_messages_misc_collection_id
APPWRITE_USER_AVATARS_BUCKET_ID=your_user_avatars_bucket_id

# New collections (create manually — see ../docs/SETUP.md)
APPWRITE_CHAT_MESSAGES_COLLECTION_ID=chatbot_messages
APPWRITE_USER_FACTS_COLLECTION_ID=chatbot_user_facts

# Dedicated Appwrite user used by the benchmark harness. Setting this enables
# benchmark-only token telemetry and skips post-response memory curation.
BENCHMARK_TEST_USER_ID=

# ── Feature flags ───────────────────────────────────────────────────────────
ENABLE_RERANKER=false
ENABLE_KNOWLEDGE_GRAPH=false
ENABLE_WEB_SEARCH_FALLBACK=false

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
METRICS_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=  # leave unset to disable tracing

# ── Request limits ──────────────────────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=60
MAX_CONVERSATION_TURNS=10
MAX_USER_FACTS=30
CF_WORKERS_AI_DAILY_QUOTA=10000
ENABLE_LOCAL_EMBEDDING_FALLBACK=true
