# Normalize line endings: LF in repo, OS-native on checkout
* text=auto

# Force LF for cross-platform files
*.dart text eol=lf
*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.sh   text eol=lf

# Native Windows files keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary — never mangle
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.wav  binary
*.mp3  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
