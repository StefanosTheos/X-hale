    "version": "0.2.0",
    "configurations": [
        {
            "name": "smoking (local backend)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--dart-define=HAILEY_API_URL=http://10.0.2.2:7860"
            ]
        },
        {
            "name": "smoking (HF Space)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--dart-define=HAILEY_API_URL=https://stefanostheos-hailey-backend.hf.space"
            ]
        },
        {
            "name": "smoking (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": [
                "--dart-define=HAILEY_API_URL=https://stefanostheos-hailey-backend.hf.space"
            ]
        },
        {
            "name": "smoking (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": [
                "--dart-define=HAILEY_API_URL=https://stefanostheos-hailey-backend.hf.space"
            ]
        },
        {
            "name": "starter-for-flutter",
            "cwd": "starter-for-flutter",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "starter-for-flutter (profile mode)",
            "cwd": "starter-for-flutter",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "starter-for-flutter (release mode)",
            "cwd": "starter-for-flutter",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}